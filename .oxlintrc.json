{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn"],
	"jsPlugins": ["eslint-plugin-boundaries"],
	"categories": {
		"correctness": "off"
	},
	"options": {
		"typeAware": true,
		"maxWarnings": 0
	},
	"env": {
		"builtin": true
	},
	"ignorePatterns": [
		"node_modules/",
		"dist/",
		"build/",
		"coverage/",
		".react-router/",
		".docusaurus/"
	],
	"settings": {
		"import/resolver": {
			"typescript": {
				"alwaysTryTypes": true
			},
			"eslint-import-resolver-node": {
				"extensions": [".js", ".jsx", ".ts", ".tsx"]
			}
		},
		"boundaries/elements": [
			{
				"type": "tests",
				"pattern": "src/**/*.test.ts",
				"mode": "full"
			},
			{
				"type": "shared-ids",
				"pattern": "src/lib/ids.ts",
				"mode": "full"
			},
			{
				"type": "category-composition",
				"pattern": ["src/domains/ledgers/accounts/categories/index.ts"],
				"mode": "full"
			},
			{
				"type": "category-domain",
				"pattern": [
					"src/domains/ledgers/accounts/categories/LedgerAccountCategoryEntity.ts",
					"src/domains/ledgers/accounts/categories/LedgerAccountCategoryErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "category-repo",
				"pattern": ["src/domains/ledgers/accounts/categories/LedgerAccountCategoryRepo.ts"],
				"mode": "full"
			},
			{
				"type": "category-service",
				"pattern": ["src/domains/ledgers/accounts/categories/LedgerAccountCategoryService.ts"],
				"mode": "full"
			},
			{
				"type": "category-routes",
				"pattern": ["src/domains/ledgers/accounts/categories/LedgerAccountCategoryRoutes.ts"],
				"mode": "full"
			},
			{
				"type": "category-transport",
				"pattern": ["src/domains/ledgers/accounts/categories/LedgerAccountCategorySchema.ts"],
				"mode": "full"
			},
			{
				"type": "category-fixtures",
				"pattern": ["src/domains/ledgers/accounts/categories/fixtures.ts"],
				"mode": "full"
			},
			{
				"type": "http",
				"pattern": "src/http/**/*",
				"mode": "full"
			},
			{
				"type": "ledger-composition",
				"pattern": "src/domains/ledgers/index.ts",
				"mode": "full"
			},
			{
				"type": "ledger-routes",
				"pattern": "src/domains/ledgers/LedgerRoutes.ts",
				"mode": "full"
			},
			{
				"type": "ledger-service",
				"pattern": "src/domains/ledgers/LedgerService.ts",
				"mode": "full"
			},
			{
				"type": "ledger-repo",
				"pattern": "src/domains/ledgers/LedgerRepo.ts",
				"mode": "full"
			},
			{
				"type": "ledger-domain",
				"pattern": ["src/domains/ledgers/Ledger.ts", "src/domains/ledgers/LedgerErrors.ts"],
				"mode": "full"
			},
			{
				"type": "ledger-transport",
				"pattern": "src/domains/ledgers/LedgerSchema.ts",
				"mode": "full"
			},
			{
				"type": "account-composition",
				"pattern": "src/domains/ledgers/accounts/index.ts",
				"mode": "full"
			},
			{
				"type": "account-routes",
				"pattern": "src/domains/ledgers/accounts/AccountRoutes.ts",
				"mode": "full"
			},
			{
				"type": "account-service",
				"pattern": "src/domains/ledgers/accounts/AccountService.ts",
				"mode": "full"
			},
			{
				"type": "account-repo",
				"pattern": "src/domains/ledgers/accounts/LedgerAccountRepo.ts",
				"mode": "full"
			},
			{
				"type": "account-domain",
				"pattern": [
					"src/domains/ledgers/accounts/LedgerAccount.ts",
					"src/domains/ledgers/accounts/AccountErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "account-transport",
				"pattern": "src/domains/ledgers/accounts/AccountSchema.ts",
				"mode": "full"
			},
			{
				"type": "transaction-composition",
				"pattern": "src/domains/ledgers/transactions/index.ts",
				"mode": "full"
			},
			{
				"type": "transaction-routes",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionRoutes.ts",
				"mode": "full"
			},
			{
				"type": "transaction-service",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionService.ts",
				"mode": "full"
			},
			{
				"type": "transaction-repo",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionRepo.ts",
				"mode": "full"
			},
			{
				"type": "transaction-capability",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionIdemService.ts",
				"mode": "full"
			},
			{
				"type": "idempotency-capability",
				"pattern": "src/lib/IdempotencyService.ts",
				"mode": "full"
			},
			{
				"type": "transaction-domain",
				"pattern": [
					"src/domains/ledgers/transactions/LedgerTransaction.ts",
					"src/domains/ledgers/transactions/LedgerTransactionEntry.ts",
					"src/domains/ledgers/transactions/LedgerTransactionErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "transaction-transport",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionSchema.ts",
				"mode": "full"
			},
			{
				"type": "organization-composition",
				"pattern": "src/domains/organizations/index.ts",
				"mode": "full"
			},
			{
				"type": "organization-routes",
				"pattern": "src/domains/organizations/OrganizationRoutes.ts",
				"mode": "full"
			},
			{
				"type": "organization-service",
				"pattern": "src/domains/organizations/OrganizationService.ts",
				"mode": "full"
			},
			{
				"type": "organization-repo",
				"pattern": "src/domains/organizations/OrganizationRepo.ts",
				"mode": "full"
			},
			{
				"type": "organization-domain",
				"pattern": [
					"src/domains/organizations/Organization.ts",
					"src/domains/organizations/OrganizationErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "organization-capability",
				"pattern": "src/domains/organizations/OrganizationIdGenerator.ts",
				"mode": "full"
			},
			{
				"type": "organization-transport",
				"pattern": "src/domains/organizations/OrganizationSchema.ts",
				"mode": "full"
			},
			{
				"type": "persistence-schema",
				"pattern": "src/db/schema.ts",
				"mode": "full"
			},
			{
				"type": "database",
				"pattern": "src/db/**/*",
				"mode": "full"
			},
			{
				"type": "runtime",
				"pattern": "src/runtime.ts",
				"mode": "full"
			},
			{
				"type": "config",
				"pattern": "src/Config.ts",
				"mode": "full"
			},
			{
				"type": "server",
				"pattern": "src/Server.ts",
				"mode": "full"
			}
		]
	},
	"rules": {
		"eqeqeq": "error",
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_",
				"destructuredArrayIgnorePattern": "^_"
			}
		],
		"no-useless-switch-case": "error",
		"unicorn/catch-error-name": "error",
		"unicorn/consistent-function-scoping": "error",
		"unicorn/no-array-callback-reference": "error",
		"unicorn/no-array-for-each": "error",
		"unicorn/no-array-reduce": "error",
		"unicorn/no-instanceof-array": "error",
		"unicorn/no-null": "error",
		"unicorn/no-thenable": "error",
		"unicorn/no-useless-spread": "error",
		"unicorn/prefer-array-find": "error",
		"unicorn/prefer-export-from": "error",
		"unicorn/prefer-array-flat-map": "error",
		"unicorn/prefer-includes": "error",
		"unicorn/prefer-module": "error",
		"unicorn/prefer-node-protocol": "error",
		"unicorn/prefer-number-properties": "error",
		"unicorn/prefer-object-from-entries": "error",
		"unicorn/prefer-set-has": "error",
		"unicorn/prefer-spread": "error",
		"unicorn/prefer-top-level-await": "error",
		"typescript/await-thenable": "error",
		"typescript/ban-ts-comment": "error",
		"typescript/no-array-delete": "error",
		"typescript/no-base-to-string": "error",
		"typescript/no-duplicate-enum-values": "error",
		"typescript/no-duplicate-type-constituents": "error",
		"typescript/no-dynamic-delete": "error",
		"typescript/no-empty-object-type": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-extra-non-null-assertion": "error",
		"typescript/no-extraneous-class": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-for-in-array": "error",
		"typescript/no-implied-eval": "error",
		"typescript/no-misused-new": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-namespace": "error",
		"typescript/no-non-null-asserted-optional-chain": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-require-imports": "error",
		"typescript/no-this-alias": "error",
		"typescript/no-unnecessary-type-assertion": "off",
		"typescript/no-unnecessary-type-constraint": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-declaration-merging": "error",
		"typescript/no-unsafe-enum-comparison": "error",
		"typescript/no-unsafe-function-type": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/no-unsafe-unary-minus": "error",
		"typescript/no-wrapper-object-types": "error",
		"typescript/only-throw-error": "error",
		"typescript/prefer-as-const": "error",
		"typescript/prefer-for-of": "error",
		"typescript/prefer-namespace-keyword": "error",
		"typescript/prefer-promise-reject-errors": "error",
		"typescript/require-await": "off",
		"typescript/restrict-plus-operands": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/triple-slash-reference": "error",
		"typescript/unbound-method": "off",
		"boundaries/element-types": [
			"error",
			{
				"default": "disallow",
				"rules": [
					{
						"from": ["tests"],
						"allow": ["*"]
					},
					{
						"from": ["persistence-schema"],
						"disallow": ["*"]
					},
					{
						"from": ["ledger-domain"],
						"allow": [
							"ledger-domain",
							"ledger-transport",
							"database",
							"http",
							"shared-ids",
							"organization-composition",
							"persistence-schema"
						]
					},
					{
						"from": ["ledger-repo"],
						"allow": [
							"ledger-domain",
							"database",
							"organization-composition",
							"shared-ids",
							"persistence-schema"
						]
					},
					{
						"from": ["ledger-service"],
						"allow": ["ledger-domain", "ledger-repo", "ledger-transport", "http", "shared-ids"]
					},
					{
						"from": ["ledger-transport"],
						"allow": ["ledger-domain"]
					},
					{
						"from": ["ledger-routes"],
						"allow": ["ledger-domain", "ledger-service", "ledger-transport", "http", "shared-ids"]
					},
					{
						"from": ["ledger-composition"],
						"allow": ["ledger-domain", "ledger-repo", "ledger-routes", "ledger-service"]
					},
					{
						"from": ["account-domain"],
						"allow": [
							"account-domain",
							"account-transport",
							"database",
							"ledger-domain",
							"shared-ids",
							"persistence-schema"
						]
					},
					{
						"from": ["account-repo"],
						"allow": [
							"account-repo",
							"account-domain",
							"ledger-domain",
							"database",
							"http",
							"shared-ids",
							"persistence-schema"
						]
					},
					{
						"from": ["account-service"],
						"allow": [
							"account-domain",
							"account-repo",
							"account-transport",
							"ledger-domain",
							"ledger-service",
							"http",
							"shared-ids"
						]
					},
					{
						"from": ["account-transport"],
						"allow": ["account-domain", "ledger-domain", "ledger-transport"]
					},
					{
						"from": ["account-routes"],
						"allow": ["account-service", "account-transport", "http", "shared-ids"]
					},
					{
						"from": ["account-composition"],
						"allow": [
							"account-domain",
							"account-repo",
							"account-routes",
							"account-service",
							"account-transport"
						]
					},
					{
						"from": ["transaction-domain"],
						"allow": [
							"transaction-domain",
							"transaction-transport",
							"account-composition",
							"account-domain",
							"database",
							"http",
							"shared-ids",
							"persistence-schema"
						]
					},
					{
						"from": ["transaction-repo"],
						"allow": [
							"transaction-repo",
							"transaction-domain",
							"transaction-transport",
							"account-composition",
							"account-domain",
							"database",
							"http",
							"shared-ids",
							"persistence-schema"
						]
					},
					{
						"from": ["transaction-capability"],
						"allow": ["transaction-domain", "http", "shared-ids"]
					},
					{
						"from": ["idempotency-capability"],
						"allow": ["http", "shared-ids"]
					},
					{
						"from": ["transaction-service"],
						"allow": [
							"transaction-domain",
							"transaction-repo",
							"transaction-capability",
							"idempotency-capability",
							"transaction-transport",
							"account-composition",
							"account-domain",
							"ledger-service",
							"database",
							"http",
							"shared-ids"
						]
					},
					{
						"from": ["transaction-transport"],
						"allow": ["ledger-transport", "transaction-domain"]
					},
					{
						"from": ["transaction-routes"],
						"allow": ["transaction-service", "transaction-transport", "http", "shared-ids"]
					},
					{
						"from": ["transaction-composition"],
						"allow": ["transaction-repo", "transaction-routes", "transaction-service"]
					},
					{
						"from": ["organization-domain"],
						"allow": [
							"organization-domain",
							"organization-transport",
							"http",
							"shared-ids",
							"persistence-schema"
						]
					},
					{
						"from": ["organization-capability"],
						"allow": ["organization-domain", "shared-ids"]
					},
					{
						"from": ["organization-repo"],
						"allow": ["organization-domain", "database", "shared-ids", "persistence-schema"]
					},
					{
						"from": ["organization-service"],
						"allow": [
							"organization-domain",
							"organization-capability",
							"organization-repo",
							"organization-transport",
							"shared-ids"
						]
					},
					{
						"from": ["organization-transport"],
						"allow": ["organization-domain", "http"]
					},
					{
						"from": ["organization-routes"],
						"allow": [
							"organization-domain",
							"organization-service",
							"organization-transport",
							"http",
							"shared-ids"
						]
					},
					{
						"from": ["organization-composition"],
						"allow": [
							"organization-capability",
							"organization-repo",
							"organization-routes",
							"organization-service",
							"organization-transport"
						]
					},
					{
						"from": ["http"],
						"allow": ["http"]
					},
					{
						"from": ["database"],
						"allow": ["database", "persistence-schema"]
					},
					{
						"from": ["runtime"],
						"allow": [
							"config",
							"database",
							"ledger-composition",
							"account-composition",
							"transaction-composition",
							"transaction-capability",
							"idempotency-capability",
							"organization-composition",
							"runtime",
							"category-composition"
						]
					},
					{
						"from": ["config"],
						"disallow": ["*"]
					},
					{
						"from": ["server"],
						"allow": [
							"config",
							"database",
							"http",
							"organization-composition",
							"runtime",
							"ledger-composition",
							"account-composition",
							"transaction-composition",
							"category-composition"
						]
					},
					{
						"from": ["shared-ids"],
						"disallow": ["*"]
					},
					{
						"from": ["category-composition"],
						"allow": ["category-repo", "category-service", "category-routes"]
					},
					{
						"from": ["category-domain"],
						"allow": ["category-transport", "shared-ids", "persistence-schema", "database"]
					},
					{
						"from": ["category-repo"],
						"allow": [
							"category-domain",
							"shared-ids",
							"persistence-schema",
							"database",
							"account-domain",
							"ledger-domain"
						]
					},
					{
						"from": ["category-service"],
						"allow": [
							"category-domain",
							"category-repo",
							"category-transport",
							"shared-ids",
							"ledger-service",
							"ledger-domain"
						]
					},
					{
						"from": ["category-routes"],
						"allow": ["category-service", "category-transport", "shared-ids"]
					},
					{
						"from": ["category-transport"],
						"allow": ["ledger-transport", "account-transport"]
					},
					{
						"from": ["category-fixtures"],
						"allow": [
							"category-domain",
							"organization-domain",
							"organization-repo",
							"ledger-domain",
							"ledger-repo",
							"account-domain",
							"account-repo",
							"shared-ids"
						]
					}
				]
			}
		],
		"boundaries/entry-point": "error"
	},
	"overrides": [
		{
			"files": ["apps/api/src/**/*.test.ts"],
			"rules": {
				"boundaries/entry-point": "off"
			}
		},
		{
			"files": ["apps/web/**/*.ts", "apps/web/**/*.tsx"],
			"env": {
				"browser": true
			}
		}
	]
}
