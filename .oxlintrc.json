{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn"],
	"jsPlugins": ["eslint-plugin-boundaries"],
	"categories": {
		"correctness": "off"
	},
	"options": {
		"typeAware": true,
		"maxWarnings": 0
	},
	"env": {
		"builtin": true
	},
	"ignorePatterns": [
		"node_modules/",
		"dist/",
		"build/",
		"coverage/",
		".react-router/",
		".docusaurus/"
	],
	"settings": {
		"import/resolver": {
			"typescript": {
				"alwaysTryTypes": true
			},
			"eslint-import-resolver-node": {
				"extensions": [".js", ".jsx", ".ts", ".tsx"]
			}
		},
		"boundaries/elements": [
			{
				"type": "tests",
				"pattern": "src/**/*.test.ts",
				"mode": "full"
			},
			{
				"type": "bench",
				"pattern": "test/bench/**/*",
				"mode": "full"
			},
			{
				"type": "test-support",
				"pattern": "src/lib/testing.ts",
				"mode": "full"
			},
			{
				"type": "asset-composition",
				"pattern": "src/domains/assets/index.ts",
				"mode": "full"
			},
			{
				"type": "asset-domain",
				"pattern": "src/domains/assets/Asset.ts",
				"mode": "full"
			},
			{
				"type": "asset-transport",
				"pattern": "src/domains/assets/AssetSchema.ts",
				"mode": "full"
			},
			{
				"type": "asset-api",
				"pattern": "src/domains/assets/AssetApi.ts",
				"mode": "full"
			},
			{
				"type": "asset-routes",
				"pattern": "src/domains/assets/AssetRoutes.ts",
				"mode": "full"
			},
			{
				"type": "asset-repo",
				"pattern": "src/domains/assets/AssetRepo.ts",
				"mode": "full"
			},
			{
				"type": "asset-service",
				"pattern": "src/domains/assets/AssetService.ts",
				"mode": "full"
			},
			{
				"type": "category-composition",
				"pattern": "src/domains/ledgers/accounts/categories/index.ts",
				"mode": "full"
			},
			{
				"type": "category-domain",
				"pattern": [
					"src/domains/ledgers/accounts/categories/LedgerAccountCategoryEntity.ts",
					"src/domains/ledgers/accounts/categories/LedgerAccountCategoryErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "category-repo",
				"pattern": "src/domains/ledgers/accounts/categories/LedgerAccountCategoryRepo.ts",
				"mode": "full"
			},
			{
				"type": "category-service",
				"pattern": "src/domains/ledgers/accounts/categories/LedgerAccountCategoryService.ts",
				"mode": "full"
			},
			{
				"type": "category-routes",
				"pattern": "src/domains/ledgers/accounts/categories/LedgerAccountCategoryRoutes.ts",
				"mode": "full"
			},
			{
				"type": "category-transport",
				"pattern": "src/domains/ledgers/accounts/categories/LedgerAccountCategorySchema.ts",
				"mode": "full"
			},
			{
				"type": "category-api",
				"pattern": "src/domains/ledgers/accounts/categories/LedgerAccountCategoryApi.ts",
				"mode": "full"
			},
			{
				"type": "category-fixtures",
				"pattern": "src/domains/ledgers/accounts/categories/fixtures.ts",
				"mode": "full"
			},
			{
				"type": "ledger-composition",
				"pattern": "src/domains/ledgers/index.ts",
				"mode": "full"
			},
			{
				"type": "ledger-routes",
				"pattern": "src/domains/ledgers/LedgerRoutes.ts",
				"mode": "full"
			},
			{
				"type": "ledger-service",
				"pattern": "src/domains/ledgers/LedgerService.ts",
				"mode": "full"
			},
			{
				"type": "ledger-repo",
				"pattern": "src/domains/ledgers/LedgerRepo.ts",
				"mode": "full"
			},
			{
				"type": "ledger-domain",
				"pattern": ["src/domains/ledgers/Ledger.ts", "src/domains/ledgers/LedgerErrors.ts"],
				"mode": "full"
			},
			{
				"type": "ledger-transport",
				"pattern": "src/domains/ledgers/LedgerSchema.ts",
				"mode": "full"
			},
			{
				"type": "ledger-api",
				"pattern": "src/domains/ledgers/LedgerApi.ts",
				"mode": "full"
			},
			{
				"type": "account-composition",
				"pattern": "src/domains/ledgers/accounts/index.ts",
				"mode": "full"
			},
			{
				"type": "account-routes",
				"pattern": "src/domains/ledgers/accounts/AccountRoutes.ts",
				"mode": "full"
			},
			{
				"type": "account-service",
				"pattern": "src/domains/ledgers/accounts/AccountService.ts",
				"mode": "full"
			},
			{
				"type": "account-repo",
				"pattern": "src/domains/ledgers/accounts/LedgerAccountRepo.ts",
				"mode": "full"
			},
			{
				"type": "account-domain",
				"pattern": [
					"src/domains/ledgers/accounts/LedgerAccount.ts",
					"src/domains/ledgers/accounts/AccountErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "account-transport",
				"pattern": "src/domains/ledgers/accounts/AccountSchema.ts",
				"mode": "full"
			},
			{
				"type": "account-api",
				"pattern": "src/domains/ledgers/accounts/AccountApi.ts",
				"mode": "full"
			},
			{
				"type": "statement-composition",
				"pattern": "src/domains/ledgers/accounts/statements/index.ts",
				"mode": "full"
			},
			{
				"type": "statement-routes",
				"pattern": "src/domains/ledgers/accounts/statements/LedgerAccountStatementRoutes.ts",
				"mode": "full"
			},
			{
				"type": "statement-service",
				"pattern": "src/domains/ledgers/accounts/statements/LedgerAccountStatementService.ts",
				"mode": "full"
			},
			{
				"type": "statement-repo",
				"pattern": "src/domains/ledgers/accounts/statements/LedgerAccountStatementRepo.ts",
				"mode": "full"
			},
			{
				"type": "statement-domain",
				"pattern": "src/domains/ledgers/accounts/statements/LedgerAccountStatement.ts",
				"mode": "full"
			},
			{
				"type": "statement-transport",
				"pattern": "src/domains/ledgers/accounts/statements/LedgerAccountStatementSchema.ts",
				"mode": "full"
			},
			{
				"type": "statement-api",
				"pattern": "src/domains/ledgers/accounts/statements/LedgerAccountStatementApi.ts",
				"mode": "full"
			},
			{
				"type": "monitor-composition",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/index.ts",
				"mode": "full"
			},
			{
				"type": "monitor-routes",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitorRoutes.ts",
				"mode": "full"
			},
			{
				"type": "monitor-service",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitorService.ts",
				"mode": "full"
			},
			{
				"type": "monitor-repo",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitorRepo.ts",
				"mode": "full"
			},
			{
				"type": "monitor-domain",
				"pattern": [
					"src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitor.ts",
					"src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitorErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "monitor-transport",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitorSchema.ts",
				"mode": "full"
			},
			{
				"type": "monitor-api",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitorApi.ts",
				"mode": "full"
			},
			{
				"type": "monitor-capability",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/LedgerAccountBalanceMonitorJob.ts",
				"mode": "full"
			},
			{
				"type": "monitor-fixtures",
				"pattern": "src/domains/ledgers/accounts/balance-monitors/fixtures.ts",
				"mode": "full"
			},
			{
				"type": "settlement-composition",
				"pattern": "src/domains/ledgers/settlements/index.ts",
				"mode": "full"
			},
			{
				"type": "settlement-routes",
				"pattern": "src/domains/ledgers/settlements/LedgerAccountSettlementRoutes.ts",
				"mode": "full"
			},
			{
				"type": "settlement-service",
				"pattern": "src/domains/ledgers/settlements/LedgerAccountSettlementService.ts",
				"mode": "full"
			},
			{
				"type": "settlement-repo",
				"pattern": "src/domains/ledgers/settlements/LedgerAccountSettlementRepo.ts",
				"mode": "full"
			},
			{
				"type": "settlement-domain",
				"pattern": [
					"src/domains/ledgers/settlements/LedgerAccountSettlementEntity.ts",
					"src/domains/ledgers/settlements/LedgerAccountSettlementErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "settlement-transport",
				"pattern": "src/domains/ledgers/settlements/LedgerAccountSettlementSchema.ts",
				"mode": "full"
			},
			{
				"type": "settlement-api",
				"pattern": "src/domains/ledgers/settlements/LedgerAccountSettlementApi.ts",
				"mode": "full"
			},
			{
				"type": "transaction-composition",
				"pattern": "src/domains/ledgers/transactions/index.ts",
				"mode": "full"
			},
			{
				"type": "transaction-routes",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionRoutes.ts",
				"mode": "full"
			},
			{
				"type": "transaction-service",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionService.ts",
				"mode": "full"
			},
			{
				"type": "transaction-repo",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionRepo.ts",
				"mode": "full"
			},
			{
				"type": "transaction-capability",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionIdemService.ts",
				"mode": "full"
			},
			{
				"type": "idempotency-capability",
				"pattern": "src/lib/IdempotencyService.ts",
				"mode": "full"
			},
			{
				"type": "transaction-domain",
				"pattern": [
					"src/domains/ledgers/transactions/LedgerTransaction.ts",
					"src/domains/ledgers/transactions/LedgerTransactionEntry.ts",
					"src/domains/ledgers/transactions/LedgerTransactionErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "transaction-transport",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionSchema.ts",
				"mode": "full"
			},
			{
				"type": "transaction-api",
				"pattern": "src/domains/ledgers/transactions/LedgerTransactionApi.ts",
				"mode": "full"
			},
			{
				"type": "organization-composition",
				"pattern": "src/domains/organizations/index.ts",
				"mode": "full"
			},
			{
				"type": "organization-routes",
				"pattern": "src/domains/organizations/OrganizationRoutes.ts",
				"mode": "full"
			},
			{
				"type": "organization-service",
				"pattern": "src/domains/organizations/OrganizationService.ts",
				"mode": "full"
			},
			{
				"type": "organization-repo",
				"pattern": "src/domains/organizations/OrganizationRepo.ts",
				"mode": "full"
			},
			{
				"type": "organization-domain",
				"pattern": [
					"src/domains/organizations/Organization.ts",
					"src/domains/organizations/OrganizationErrors.ts"
				],
				"mode": "full"
			},
			{
				"type": "organization-capability",
				"pattern": "src/domains/organizations/OrganizationIdGenerator.ts",
				"mode": "full"
			},
			{
				"type": "organization-transport",
				"pattern": "src/domains/organizations/OrganizationSchema.ts",
				"mode": "full"
			},
			{
				"type": "organization-api",
				"pattern": "src/domains/organizations/OrganizationApi.ts",
				"mode": "full"
			},
			{
				"type": "persistence-schema",
				"pattern": "src/db/schema.ts",
				"mode": "full"
			},
			{
				"type": "database",
				"pattern": "src/db/**/*",
				"mode": "full"
			},
			{
				"type": "api-composition",
				"pattern": "src/api.ts",
				"mode": "full"
			},
			{
				"type": "auth",
				"pattern": "src/auth.ts",
				"mode": "full"
			},
			{
				"type": "runtime",
				"pattern": "src/runtime.ts",
				"mode": "full"
			},
			{
				"type": "config",
				"pattern": "src/config.ts",
				"mode": "full"
			},
			{
				"type": "telemetry",
				"pattern": "src/telemetry.ts",
				"mode": "full"
			},
			{
				"type": "server",
				"pattern": "src/server.ts",
				"mode": "full"
			},
			{
				"type": "entrypoint",
				"pattern": ["src/index.ts", "src/worker.ts", "src/monitor-jobs.ts"],
				"mode": "full"
			},
			{
				"type": "shared-ids",
				"pattern": "src/lib/ids.ts",
				"mode": "full"
			},
			{
				"type": "lib-errors",
				"pattern": "src/lib/errors.ts",
				"mode": "full"
			},
			{
				"type": "lib-contract",
				"pattern": "src/lib/ApiContract.ts",
				"mode": "full"
			},
			{
				"type": "lib-schema",
				"pattern": [
					"src/lib/schema.ts",
					"src/lib/ListQuery.ts",
					"src/lib/amounts.ts",
					"src/lib/AssetSchema.ts",
					"src/lib/IdempotencySchema.ts"
				],
				"mode": "full"
			},
			{
				"type": "lib-util",
				"pattern": ["src/lib/utils.ts", "src/lib/crypto.ts", "src/lib/luxon.ts"],
				"mode": "full"
			},
			{
				"type": "lib-queues",
				"pattern": "src/lib/queues.ts",
				"mode": "full"
			},
			{
				"type": "lib-metrics",
				"pattern": "src/lib/metrics.ts",
				"mode": "full"
			}
		],
		"boundaries/include": ["src/**/*", "test/bench/**/*"]
	},
	"rules": {
		"eqeqeq": "error",
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_",
				"destructuredArrayIgnorePattern": "^_"
			}
		],
		"no-useless-switch-case": "error",
		"unicorn/catch-error-name": "error",
		"unicorn/consistent-function-scoping": "error",
		"unicorn/no-array-callback-reference": "error",
		"unicorn/no-array-for-each": "error",
		"unicorn/no-array-reduce": "error",
		"unicorn/no-instanceof-array": "error",
		"unicorn/no-null": "error",
		"unicorn/no-thenable": "error",
		"unicorn/no-useless-spread": "error",
		"unicorn/prefer-array-find": "error",
		"unicorn/prefer-export-from": "error",
		"unicorn/prefer-array-flat-map": "error",
		"unicorn/prefer-includes": "error",
		"unicorn/prefer-module": "error",
		"unicorn/prefer-node-protocol": "error",
		"unicorn/prefer-number-properties": "error",
		"unicorn/prefer-object-from-entries": "error",
		"unicorn/prefer-set-has": "error",
		"unicorn/prefer-spread": "error",
		"unicorn/prefer-top-level-await": "error",
		"typescript/await-thenable": "error",
		"typescript/ban-ts-comment": "error",
		"typescript/no-array-delete": "error",
		"typescript/no-base-to-string": "error",
		"typescript/no-duplicate-enum-values": "error",
		"typescript/no-duplicate-type-constituents": "error",
		"typescript/no-dynamic-delete": "error",
		"typescript/no-empty-object-type": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-extra-non-null-assertion": "error",
		"typescript/no-extraneous-class": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-for-in-array": "error",
		"typescript/no-implied-eval": "error",
		"typescript/no-misused-new": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-namespace": "error",
		"typescript/no-non-null-asserted-optional-chain": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-require-imports": "error",
		"typescript/no-this-alias": "error",
		"typescript/no-unnecessary-type-assertion": "off",
		"typescript/no-unnecessary-type-constraint": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-declaration-merging": "error",
		"typescript/no-unsafe-enum-comparison": "error",
		"typescript/no-unsafe-function-type": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/no-unsafe-unary-minus": "error",
		"typescript/no-wrapper-object-types": "error",
		"typescript/only-throw-error": "error",
		"typescript/prefer-as-const": "error",
		"typescript/prefer-for-of": "error",
		"typescript/prefer-namespace-keyword": "error",
		"typescript/prefer-promise-reject-errors": "error",
		"typescript/require-await": "off",
		"typescript/restrict-plus-operands": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/triple-slash-reference": "error",
		"typescript/unbound-method": "off",
		"boundaries/element-types": [
			"error",
			{
				"default": "disallow",
				"rules": [
					{
						"from": ["tests", "bench"],
						"allow": ["*"]
					},
					{
						"from": ["test-support"],
						"allow": [
							"auth",
							"config",
							"asset-service",
							"account-service",
							"monitor-service",
							"category-service",
							"statement-service",
							"ledger-service",
							"settlement-service",
							"transaction-service",
							"organization-composition",
							"runtime",
							"server"
						]
					},
					{
						"from": ["asset-composition"],
						"allow": ["asset-domain", "asset-repo", "asset-service"]
					},
					{
						"from": ["asset-domain"],
						"allow": [
							"persistence-schema",
							"lib-schema",
							"lib-errors",
							"shared-ids",
							"lib-util",
							"asset-transport"
						]
					},
					{
						"from": ["asset-transport"],
						"allow": ["lib-schema"]
					},
					{
						"from": ["asset-api"],
						"allow": ["lib-errors", "lib-contract", "asset-transport"]
					},
					{
						"from": ["asset-routes"],
						"allow": ["api-composition", "auth", "shared-ids", "lib-util", "asset-service"]
					},
					{
						"from": ["asset-repo"],
						"allow": [
							"lib-util",
							"database",
							"lib-errors",
							"shared-ids",
							"persistence-schema",
							"asset-domain",
							"asset-transport"
						]
					},
					{
						"from": ["asset-service"],
						"allow": ["lib-schema", "shared-ids", "asset-domain", "asset-repo", "asset-transport"]
					},
					{
						"from": ["category-composition"],
						"allow": ["category-repo", "category-service"]
					},
					{
						"from": ["category-domain"],
						"allow": [
							"lib-schema",
							"persistence-schema",
							"lib-util",
							"category-transport",
							"shared-ids",
							"database",
							"lib-errors"
						]
					},
					{
						"from": ["category-repo"],
						"allow": [
							"lib-errors",
							"category-domain",
							"lib-util",
							"database",
							"account-domain",
							"ledger-domain",
							"shared-ids",
							"persistence-schema"
						]
					},
					{
						"from": ["category-service"],
						"allow": [
							"ledger-service",
							"category-domain",
							"shared-ids",
							"category-repo",
							"category-transport"
						]
					},
					{
						"from": ["category-routes"],
						"allow": ["api-composition", "auth", "shared-ids", "lib-util", "category-service"]
					},
					{
						"from": ["category-transport"],
						"allow": ["lib-schema", "ledger-transport", "account-transport"]
					},
					{
						"from": ["category-api"],
						"allow": ["lib-contract", "lib-errors", "lib-schema", "category-transport"]
					},
					{
						"from": ["category-fixtures"],
						"allow": [
							"organization-domain",
							"organization-repo",
							"ledger-domain",
							"ledger-repo",
							"account-domain",
							"account-repo",
							"shared-ids",
							"lib-schema",
							"category-domain"
						]
					},
					{
						"from": ["ledger-composition"],
						"allow": ["ledger-repo", "ledger-service", "ledger-domain"]
					},
					{
						"from": ["ledger-routes"],
						"allow": ["api-composition", "auth", "lib-util", "ledger-service"]
					},
