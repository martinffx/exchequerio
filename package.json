{
	"name": "exchequerio",
	"private": true,
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11.18.0 <12"
	},
	"scripts": {
		"docker:up": "docker-compose --profile infra up -d",
		"docker:up:api": "docker-compose --profile api up -d --build",
		"docker:down": "docker-compose --profile \"*\" down",
		"docker:logs": "docker-compose --profile \"*\" logs -f",
		"docker:logs:db": "docker-compose --profile infra logs -f db",
		"docker:logs:redis": "docker-compose --profile infra logs -f valkey",
		"docker:logs:api": "docker-compose --profile api logs -f api",
		"dev": "pnpm run docker:up && turbo dev",
		"dev:api": "pnpm run docker:up && turbo dev --filter=@exchequerio/api",
		"dev:web": "turbo dev --filter=@exchequerio/web",
		"dev:docs": "turbo dev --filter=@exchequerio/docs",
		"build": "turbo build",
		"test": "pnpm run docker:up && turbo test",
		"test:ci": "turbo test:ci",
		"lint": "turbo lint",
		"format": "turbo format",
		"format:check": "turbo format:check",
		"types": "turbo types",
		"check": "turbo run format:check lint types bench:check",
		"ci": "pnpm run docker:up && turbo build format:check lint types bench:check test:ci",
		"ci:gh": "turbo build format:check lint types bench:check test:ci"
	},
	"devDependencies": {
		"@typescript/native": "npm:typescript@7.0.2",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^4.2.0",
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"oxlint-tsgolint": "7.0.2001",
		"turbo": "^2"
	}
}
