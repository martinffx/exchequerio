JWT_SECRET=change-me-for-local-development
DATABASE_URL=postgresql://postgres:password@localhost:5432/ledger?schema=public
VALKEY_URL=redis://localhost:6379
# Generate once with: openssl rand -base64 32
# Share this key between the API and worker; retain it while encrypted jobs remain.
BALANCE_MONITOR_ENCRYPTION_KEY=

# OpenTelemetry export is per signal: each needs the endpoint plus its own OTEL_<SIGNAL>_EXPORTER=otlp;
# headers are optional. Console logs are unaffected.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_HEADERS=
