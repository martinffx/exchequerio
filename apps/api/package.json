{
	"name": "@exchequerio/api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "dotenvx run -- tsx watch ./src/index.ts",
		"start": "dotenvx run -- tsx ./src/index.ts",
		"test": "NODE_ENV=test dotenvx run -f .env.test -- vitest run",
		"test:watch": "NODE_ENV=test dotenvx run -f .env.test -- vitest",
		"test:ci": "NODE_ENV=test dotenvx run -f .env.test -- vitest run --coverage",
		"bench": "NODE_ENV=test dotenvx run -f .env.test -- vitest run --config vitest.bench.config.ts",
		"lint": "oxlint -c ../../.oxlintrc.json ./src --max-warnings 0 --report-unused-disable-directives",
		"lint:fix": "oxlint -c ../../.oxlintrc.json ./src --fix",
		"format": "oxfmt ./src",
		"format:check": "oxfmt --check ./src",
		"types": "tsc --noEmit",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "dotenvx run -- drizzle-kit migrate"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^1.51.1",
		"@fastify/auth": "^5.0.3",
		"@fastify/jwt": "^10.0.0",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/swagger": "^9.6.1",
		"@fastify/swagger-ui": "^5.2.3",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@fastify/under-pressure": "^9.0.3",
		"@sinclair/typebox": "^0.34.41",
		"drizzle-orm": "^0.44.7",
		"effect": "beta",
		"fast-jwt": "^6.0.2",
		"fastify": "^5.6.2",
		"fastify-plugin": "^5.1.0",
		"ioredis": "^6.0.0",
		"luxon": "^3.7.2",
		"pg": "^8.16.3",
		"pino-pretty": "^13.1.2",
		"radash": "^12.1.1",
		"tsx": "4.20.6",
		"typeid-js": "^1.2.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@exchequerio/typescript-config": "workspace:*",
		"@faker-js/faker": "^10.1.0",
		"@tsconfig/node-lts": "^24.0.0",
		"@tsconfig/recommended": "^1.0.13",
		"@types/autocannon": "^7.12.7",
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.15.6",
		"@vitest/coverage-v8": "^4.0.14",
		"autocannon": "^8.0.0",
		"drizzle-kit": "^0.31.7",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "^4.0.14"
	}
}
