{
	"name": "@exchequerio/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"dev": "dotenvx run -- tsx watch ./src/index.ts",
		"start": "node ./dist/index.mjs",
		"test": "NODE_ENV=test dotenvx run -f .env.test -- vitest run",
		"test:watch": "NODE_ENV=test dotenvx run -f .env.test -- vitest",
		"test:ci": "NODE_ENV=test dotenvx run -f .env.test -- vitest run --coverage",
		"bench": "NODE_ENV=test dotenvx run -f .env.test -- vitest run --config vitest.bench.config.ts",
		"bench:check": "BENCH_CHECK=true vitest list --config vitest.bench.config.ts",
		"lint": "oxlint -c ../../.oxlintrc.json ./src ./test/bench --max-warnings 0 --report-unused-disable-directives",
		"lint:fix": "oxlint -c ../../.oxlintrc.json ./src ./test/bench --fix",
		"format": "oxfmt ./src ./test/bench",
		"format:check": "oxfmt --check ./src ./test/bench",
		"types": "tsc --noEmit",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "dotenvx run -- drizzle-kit migrate",
		"dev:worker": "dotenvx run -- tsx watch ./src/worker.ts",
		"start:worker": "node ./dist/worker.mjs",
		"monitor:jobs": "dotenvx run -- tsx ./src/monitor-jobs.ts"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.0-rc.112",
		"@effect/sql-pg": "4.0.0-rc.112",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"effect": "4.0.0-rc.112",
		"effect-mq": "0.7.0",
		"fast-jwt": "^6.0.2",
		"ioredis": "^6.0.0",
		"luxon": "^3.7.2",
		"pg": "^8.16.3",
		"radash": "^12.1.1",
		"typeid-js": "^1.2.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^1.75.1",
		"@exchequerio/typescript-config": "workspace:*",
		"@faker-js/faker": "^10.1.0",
		"@testcontainers/postgresql": "12.2.1",
		"@tsconfig/node-lts": "^24.0.0",
		"@tsconfig/recommended": "^1.0.13",
		"@types/autocannon": "^7.12.7",
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.15.6",
		"@vitest/coverage-v8": "^4.0.14",
		"autocannon": "^8.0.0",
		"drizzle-kit": "1.0.0-rc.4",
		"testcontainers": "12.2.1",
		"tsdown": "^0.22.14",
		"tsx": "4.20.6",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "^4.0.14"
	}
}
