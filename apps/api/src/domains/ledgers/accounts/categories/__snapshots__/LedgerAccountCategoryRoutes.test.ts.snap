      "200": {
        "content": {
          "application/json": {
            "schema": {
              "description": "A ledger account category is a grouping of Ledger Accounts. Current balances are available from the Category balances endpoint. Ledger Account Categories can also contain other categories, which enables the creation of nested hierarchies.",
              "properties": {
                "created": {
                  "description": "Timestamp of when the ledger account category was created.",
                  "type": "string",
                },
                "description": {
