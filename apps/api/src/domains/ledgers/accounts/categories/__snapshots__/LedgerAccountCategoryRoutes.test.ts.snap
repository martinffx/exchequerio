                "metadata": {
                  "additionalProperties": {
                    "type": "string",
                  },
                  "description": "Additional data represented as key-value pairs. Both the key and value must be strings.",
                  "type": "object",
                },
                "name": {
                  "description": "The name of the ledger account category.",
                  "type": "string",
                },
                "normalBalance": {
                  "anyOf": [
