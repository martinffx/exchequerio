                        "type": "string",
                      },
                      "balances": {
                        "items": {
                          "properties": {
                            "amount": {
                              "description": "Signed 64-bit integer minor units, encoded as a decimal string.",
                              "maxLength": 20,
                              "pattern": "^(0|-?[1-9][0-9]*)$",
                              "type": "string",
                            },
                            "balanceType": {
                              "anyOf": [
                                {
                                  "enum": [
                                    "pending",
                                  ],
