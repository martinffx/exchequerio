    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "items": {
                "description": "A ledger account category is a grouping of Ledger Accounts. Current balances are available from the Category balances endpoint. Ledger Account Categories can also contain other categories, which enables the creation of nested hierarchies.",
                "properties": {
                  "created": {
                    "description": "Timestamp of when the ledger account category was created.",
                    "type": "string",
                  },
                  "description": {
                    "description": "An optional free-form description for internal use.",
                    "type": "string",
                  },
                  "id": {
                    "description": "Unique identifier for the ledger account category.",
                    "pattern": "^lac_[0-7][0-9a-hjkmnp-tv-z]{25}$",
                    "type": "string",
                  },
                  "ledgerId": {
                    "description": "The ledger's ID",
                    "pattern": "^lgr_[0-7][0-9a-hjkmnp-tv-z]{25}$",
                    "type": "string",
                  },
                  "metadata": {
                    "additionalProperties": {
                      "type": "string",
                    },
                    "description": "Additional data represented as key-value pairs. Both the key and value must be strings.",
                    "type": "object",
                  },
                  "name": {
                    "description": "The name of the ledger account category.",
                    "type": "string",
                  },
                  "normalBalance": {
                    "anyOf": [
                      {
                        "enum": [
                          "debit",
                        ],
                        "type": "string",
                      },
                      {
                        "enum": [
                          "credit",
                        ],
                        "type": "string",
                      },
                    ],
                  },
                  "updated": {
                    "description": "Timestamp of when the ledger account category was last updated.",
                    "type": "string",
                  },
                },
                "required": [
                  "id",
                  "ledgerId",
                  "name",
                  "normalBalance",
                  "created",
                  "updated",
                ],
