                            "credits",
                            "debits",
                            "amount",
                          ],
                          "type": "object",
                        },
                        "type": "array",
                      },
                      "minorUnitExponent": {
                        "maximum": 18,
                        "minimum": 0,
                        "type": "integer",
                      },
                    },
                    "required": [
                      "assetId",
                      "assetCode",
                      "minorUnitExponent",
                      "balances",
                    ],
                    "type": "object",
                  },
