{
  "balances": {
    "description": "Current balances by Asset for all distinct descendant Accounts, using one snapshot and the Category's normal balance. Membership changes after the snapshot appear on the next read.",
    "operationId": "getLedgerAccountCategoryBalances",
    "parameters": [
      {
        "description": "The ledger's ID",
        "in": "path",
        "name": "ledgerId",
