                  "pattern": "^ast_[0-7][0-9a-hjkmnp-tv-z]{25}$",
                  "type": "string",
                },
                "created": {
                  "description": "Timestamp of when the ledger account category was created.",
                  "type": "string",
                },
                "description": {
                  "description": "An optional free-form description for internal use.",
                  "type": "string",
                },
                "endDatetime": {
                  "description": "The exclusive upper bound of the ledger entries to be included in the ledger account statement.",
                  "type": "string",
                },
