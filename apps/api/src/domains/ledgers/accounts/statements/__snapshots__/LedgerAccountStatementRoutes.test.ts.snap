                  "description": "The ledger account statement ID",
                  "pattern": "^lst_[0-7][0-9a-hjkmnp-tv-z]{25}$",
                  "type": "string",
                },
                "ledgerAccountVersion": {
                  "description": "Version of the ledger account at the time of statement generation.",
