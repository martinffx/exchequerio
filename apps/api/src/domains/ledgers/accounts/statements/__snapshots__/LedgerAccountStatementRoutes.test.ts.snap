      "200": {
        "content": {
          "application/json": {
            "schema": {
              "description": "A ledger account statement is an object that provides the starting and ending balances for a specific time period. Once created, it can be used to retrieve the ledger entries and ledger transaction versions that correspond to that time period and lock version of the ledger account.",
              "properties": {
                "accountId": {
                  "description": "The ledger account's ID",
                  "pattern": "^lat_[0-7][0-9a-hjkmnp-tv-z]{25}$",
                  "type": "string",
