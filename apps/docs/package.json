{
  "name": "@exchequerio/docs",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "lint": "oxlint -c ../../.oxlintrc.json ./src --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "oxlint -c ../../.oxlintrc.json ./src --fix",
    "format": "oxfmt ./src ./docs",
    "format:check": "oxfmt --check ./src ./docs",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "^3",
    "@docusaurus/preset-classic": "^3",
    "@mdx-js/react": "^3",
    "clsx": "^2",
    "prism-react-renderer": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@exchequerio/typescript-config": "workspace:*",
    "@docusaurus/module-type-aliases": "^3",
    "@docusaurus/types": "^3",
    "@types/react": "^19",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
